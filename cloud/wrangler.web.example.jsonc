{
  "name": "project-progress-web",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SERVICE_MODE": "web",
    "AUTH_MODE": "password"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "project-progress",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
